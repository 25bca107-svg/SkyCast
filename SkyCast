            </div>
            <div class="metric">
              <span>🌧️</span><p>Rainfall</p>
              <strong id="precipitation">-- mm</strong>
            </div>
            <div class="metric">
              <span>☀️</span><p>UV index</p>
              <strong id="uvIndex">--</strong>
            </div>
          </div>
        </article>

        <article class="glass forecast-card">
          <div class="forecast-title">
            <div>
              <p class="label">THE DAYS AHEAD</p>
              <h3>5-day forecast</h3>
            </div>
            <span class="muted">Your week, at a glance</span>
          </div>
          <div id="forecast" class="forecast-list"></div>
        </article>
      </div>
    </section>

    <section id="welcomeCard" class="glass welcome">
      <div class="welcome-icon">🌤️</div>
      <p class="label">A WORLD OF WEATHER</p>
      <h2>Every place has its own sky.</h2>
      <p>Search a city or state to discover the current weather and the forecast ahead.</p>
      <div class="quick-cities">
        <button data-city="Bengaluru">Bengaluru ↗</button>
        <button data-city="Mumbai">Mumbai ↗</button>
        <button data-city="Chennai">Chennai ↗</button>
        <button data-city="Delhi">Delhi ↗</button>
      </div>
    </section>

    <footer>
      <span>© <span id="year"></span> SkyCast</span>
      <span>Weather data by Open-Meteo · Made for curious minds ✦</span>
    </footer>
  </main>

  <script src="script.js"></script>
</body>
</html>
