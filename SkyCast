function getCondition(code) {
  return conditions[code] || ["Variable conditions", "🌤️", "clouds"];
}

function updateBackground(type, isDay) {
  const key = isDay ? type : "night";
  $("background").style.backgroundImage = `url("${backgrounds[key] || backgrounds.clear}")`;
}

function showStatus(message, error = false) {
  $("statusMessage").textContent = message;
  $("statusMessage").style.color = error ? "#ffc5c5" : "#e0e9ff";
}

function formatDate(date, options) {
  return new Date(date + "T12:00:00").toLocaleDateString(undefined, options);
}

async function findPlace(query) {
  const key = query.trim().toLowerCase();
  const search = stateCities[key] || query.trim();

  const url = "https://geocoding-api.open-meteo.com/v1/search?name=" +
    encodeURIComponent(search) + "&count=10&language=en&format=json";

  const response = await fetch(url);
  if (!response.ok) throw new Error("Location search is unavailable. Try again.");

  const result = await response.json();
  if (!result.results?.length) {
    throw new Error("Place not found. Please try another city or state.");
  }

  return result.results.find(p => p.name.toLowerCase() === search.toLowerCase())
    || result.results[0];
}

async function fetchWeather(place) {
  const params = new URLSearchParams({
    latitude: place.latitude,
    longitude: place.longitude,
    current: [
      "temperature_2m",
      "relative_humidity_2m",
      "apparent_temperature",
      "is_day",
      "precipitation",
      "weather_code",
      "wind_speed_10m"
    ].join(","),
    daily: [
      "weather_code",
      "temperature_2m_max",
      "temperature_2m_min",
      "precipitation_sum",
      "uv_index_max"
    ].join(","),
    forecast_days: "5",
    timezone: "auto"
  });

  const response = await fetch(
    "https://api.open-meteo.com/v1/forecast?" + params
  );

  if (!response.ok) throw new Error("Weather data unavailable. Please try again.");
  return response.json();
}

function renderForecast(daily) {
  $("forecast").innerHTML = daily.time.map((date, i) => {
    const [description, icon] = getCondition(daily.weather_code[i]);
    const day = i === 0
      ? "Today"
      : formatDate(date, { weekday: "short" });

    const dateLabel = formatDate(date, {
      day: "numeric",
      month: "short"
    });

    return `
      <div class="forecast-day">
        <div class="day-name">${day}</div>
        <div class="day-date">${dateLabel}</div>
        <div class="day-icon">${icon}</div>
        <div class="day-description">${description}</div>
        <div class="day-temps">
          <span>${Math.round(daily.temperature_2m_max[i])}°</span>
          <span class="low">${Math.round(daily.temperature_2m_min[i])}°</span>
        </div>
      </div>
    `;
  }).join("");
}

function renderWeather(place, data) {
  const c = data.current;
  const d = data.daily;
  const [description, icon, type] = getCondition(c.weather_code);

  updateBackground(type, c.is_day === 1);

  $("cityName").textContent = [place.name, place.admin1]
    .filter((v, i, a) => v && a.indexOf(v) === i)
    .join(", ");

  $("currentDate").textContent = new Date().toLocaleDateString(undefined, {
    weekday: "long",
    month: "long",
    day: "numeric"
  });

  $("weatherIcon").textContent = icon;
  $("temperature").textContent = Math.round(c.temperature_2m) + "°";
  $("description").textContent = description;
  $("feelsLike").textContent = Math.round(c.apparent_temperature) + "°";
  $("humidity").textContent = Math.round(c.relative_humidity_2m) + "%";
  $("windSpeed").textContent = Math.round(c.wind_speed_10m) + " km/h";
  $("precipitation").textContent = Number(c.precipitation).toFixed(1) + " mm";
  $("uvIndex").textContent = Number.isFinite(d.uv_index_max?.[0])
    ? d.uv_index_max[0].toFixed(1)
    : "—";

  renderForecast(d);

  $("welcomeCard").hidden = true;
  $("weatherResult").hidden = false;
  showStatus("Weather updated for " + place.name + ".");
}

async function searchWeather(query) {
  if (!query.trim()) {
    showStatus("Please enter a city or state.", true);
    return;
  }

  const button = $("searchBtn");
  button.disabled = true;
  button.textContent = "Loading…";
  showStatus("Finding your sky…");

  try {
    const place = await findPlace(query);
    const weather = await fetchWeather(place);
    renderWeather(place, weather);
  } catch (error) {
    showStatus(error.message || "Something went wrong. Please try again.", true);
  } finally {
    button.disabled = false;
    button.textContent = "Explore ↗";
  }
}

$("searchForm").addEventListener("submit", event => {
  event.preventDefault();
  searchWeather($("cityInput").value);
});

document.querySelectorAll("[data-city]").forEach(button => {
  button.addEventListener("click", () => {
    $("cityInput").value = button.dataset.city;
    searchWeather(button.dataset.city);
  });
});

$("year").textContent = new Date().getFullYear();

// Load a default location automatically.
searchWeather("Bengaluru");


:root {
  --text: #f7f8ff;
  --muted: rgba(235, 240, 255, .68);
  --line: rgba(255, 255, 255, .17);
  --glass: rgba(13, 24, 44, .47);
}

* { box-sizing: border-box; }

body {
  margin: 0;
  min-height: 100vh;
  color: var(--text);
  font-family: "DM Sans", sans-serif;
  background: #111d32;
}

.background {
  position: fixed;
  inset: 0;
  z-index: -3;
  background: url("https://images.unsplash.com/photo-1500530855697-b586d89ba3ee?auto=format&fit=crop&w=2000&q=85") center/cover;
  transform: scale(1.03);
  transition: background-image .6s ease;
}

.overlay {
  position: fixed;
  inset: 0;
  z-index: -2;
  background: linear-gradient(115deg, rgba(5,12,26,.86), rgba(8,18,36,.48), rgba(5,12,26,.70));
}

.container {
  width: min(1120px, calc(100% - 40px));
  margin: auto;
}

.navbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 25px 0;
  border-bottom: 1px solid var(--line);
}

.logo {
  font: 700 28px Outfit, sans-serif;
  color: white;
  text-decoration: none;
}

.logo span { color: #bdceff; }

.live {
  display: flex;
  gap: 9px;
  align-items: center;
  font-size: 10px;
  letter-spacing: 1.5px;
}

.live i {
  width: 7px;
  height: 7px;
  background: #7ff0b0;
  border-radius: 50%;
  box-shadow: 0 0 12px #7ff0b0;
}

.hero { padding: 48px 0 22px; }

.eyebrow, .label {
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 2px;
  color: #c8d7ff;
}

h1 {
  font: 600 clamp(43px, 7vw, 75px)/1.05 Outfit, sans-serif;
  letter-spacing: -3px;
  margin: 16px 0;
}

h1 span {
  color: #c3d4ff;
  font-weight: 400;
}

.subtitle, .muted {
  color: var(--muted);
  font-size: 13px;
}

.search {
  margin-top: 27px;
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 9px 10px 9px 18px;
  max-width: 560px;
  border-radius: 16px;
}

.glass {
  background: var(--glass);
  border: 1px solid var(--line);
  box-shadow: 0 18px 50px rgba(0,0,0,.18),
              inset 0 1px 0 rgba(255,255,255,.08);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
}

.search > span {
  font-size: 25px;
  color: #d4e0ff;
}

.search input {
  flex: 1;
  min-width: 0;
  background: transparent;
  border: 0;
  outline: none;
  color: white;
  font: inherit;
  font-size: 13px;
}

.search input::placeholder { color: #c0c9dd; }

.search button {
  padding: 13px 17px;
  border: 0;
  border-radius: 10px;
  color: #142039;
  background: #dce6ff;
  font-weight: 700;
  cursor: pointer;
  transition: .2s;
}

.search button:hover {
  background: white;
  transform: translateY(-2px);
}

.search button:disabled { opacity: .65; cursor: wait; }

.status {
  min-height: 18px;
  font-size: 12px;
  color: #e0e9ff;
}

.dashboard {
  display: grid;
  grid-template-columns: 1.1fr .9fr;
  gap: 17px;
  animation: enter .5s ease both;
}

.current-card, .details-card, .forecast-card, .welcome {
  border-radius: 24px;
  padding: 25px;
}

.card-top, .forecast-title {
  display: flex;
  justify-content: space-between;
  gap: 15px;
  align-items: flex-start;
}

.label { margin: 0; }

h2, h3 {
  font-family: Outfit, sans-serif;
  font-weight: 500;
}

h2 {
  font-size: 27px;
  margin: 9px 0 5px;
}

h3 {
  font-size: 21px;
  margin: 8px 0 0;
}

.live-tag {
  font-size: 9px;
  border: 1px solid var(--line);
  border-radius: 30px;
  padding: 8px 10px;
  color: #a9ffd0;
}

.current-weather {
  display: flex;
  align-items: center;
  gap: 20px;
  padding: 26px 0;
}

.weather-icon {
  font-size: 68px;
  filter: drop-shadow(0 7px 14px rgba(0,0,0,.2));
}

.temperature {
  font: 500 75px/.95 Outfit, sans-serif;
  letter-spacing: -4px;
}

.description {
  color: #dce5ff;
  font-size: 13px;
  margin-top: 12px;
}

.feels {
  border-top: 1px solid var(--line);
  padding-top: 17px;
  display: flex;
  gap: 15px;
  align-items: center;
}

.feels span {
  font-size: 10px;
  color: var(--muted);
}

.feels strong { font-size: 15px; }

.details-card h3 { margin-bottom: 20px; }

.metrics {
  display: grid;
  grid-template-columns: 1fr 1fr;
}

.metric {
  padding: 15px 8px 15px 0;
  border-top: 1px solid var(--line);
}

.metric:nth-child(even) {
  border-left: 1px solid var(--line);
  padding-left: 15px;
}

.metric > span { font-size: 20px; }

.metric p {
  color: var(--muted);
  font-size: 11px;
  margin: 7px 0;
}

.metric strong {
  font: 500 22px Outfit, sans-serif;
}

.forecast-card {
  grid-column: 1 / -1;
}

.forecast-title { align-items: end; margin-bottom: 20px; }

.forecast-title .muted { font-size: 10px; }

.forecast-list {
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  gap: 10px;
}

.forecast-day {
  text-align: center;
  padding: 17px 7px;
  border: 1px solid rgba(255,255,255,.11);
  border-radius: 16px;
  background: rgba(3,12,27,.2);
  transition: .2s;
}

.forecast-day:hover {
  transform: translateY(-4px);
  background: rgba(255,255,255,.1);
}

.day-name { font-size: 12px; font-weight: 600; }
.day-date { color: var(--muted); font-size: 10px; margin-top: 5px; }
.day-icon { font-size: 28px; margin: 15px 0; }
.day-description { color: var(--muted); font-size: 10px; min-height: 25px; }
.day-temps { display: flex; justify-content: center; gap: 10px; margin-top: 12px; font: 600 14px Outfit; }
.day-temps .low { color: var(--muted); font-weight: 400; }

.welcome {
  text-align: center;
  margin: 18px 0;
  padding: 35px 20px;
}

.welcome-icon { font-size: 43px; margin-bottom: 13px; }

.welcome h2 { font-size: 26px; }

.welcome > p:not(.label) {
  color: var(--muted);
  font-size: 12px;
  line-height: 1.7;
  max-width: 440px;
  margin: auto;
}

.quick-cities {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 9px;
  margin-top: 23px;
}

.quick-cities button {
  color: white;
  background: rgba(255,255,255,.07);
  border: 1px solid var(--line);
  padding: 10px 14px;
  border-radius: 30px;
  cursor: pointer;
}

.quick-cities button:hover { background: rgba(255,255,255,.17); }

footer {
  display: flex;
  justify-content: space-between;
  gap: 15px;
  flex-wrap: wrap;
  color: rgba(235,240,255,.55);
  font-size: 10px;
  padding: 20px 0;
  margin-top: 15px;
  border-top: 1px solid var(--line);
}

[hidden] { display: none !important; }

@keyframes enter {
  from { opacity: 0; transform: translateY(10px); }
  to { opacity: 1; transform: translateY(0); }
}

@media (max-width: 720px) {
  .container { width: calc(100% - 28px); }
  .hero { padding-top: 35px; }
  .dashboard { grid-template-columns: 1fr; }
  .forecast-card { grid-column: auto; }
  .forecast-list { overflow-x: auto; grid-template-columns: repeat(5, 105px); padding-bottom: 5px; }
  .forecast-title .muted { display: none; }
  .current-card, .details-card, .forecast-card { padding: 21px; }
  footer { line-height: 1.6; }
}

@media (max-width: 420px) {
  .temperature { font-size: 63px; }
  .weather-icon { font-size: 53px; }
  .search { gap: 8px; padding-left: 12px; }
  .search button { padding: 12px 10px; }
  .search input { font-size: 12px; }
}

@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after { animation: none !important; transition: none !important; }
}


